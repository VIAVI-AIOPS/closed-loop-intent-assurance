# Closed-Loop Intent Assurance — environment configuration
#
# Copy this file to `.env` (same directory) and fill in the values.

# REQUIRED — NVIDIA NIM API key for hosted Nemotron + Llama inference.
# Sign up at https://build.nvidia.com to get one (free for development).
NVIDIA_API_KEY=

# OPTIONAL — Intent Planning Agent backend model (default shown below).
# v0.6.8 strict probe selected Meta Llama 3.3 70B over Nemotron Nano/Super
# and CONSILIUM for the highest schema-compliance + multi-op accuracy.
INSPECTOR_PLANNER_MODEL=meta/llama-3.3-70b-instruct
